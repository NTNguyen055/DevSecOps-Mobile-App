# ============================================
# Backend API Configuration
# ============================================
PORT=4001
NODE_ENV=development
JWT_SECRET=replace-with-your-own-secret

# ============================================
# Database Configuration
# ============================================
# For local development (running app outside Docker)
DATABASE_URL=postgresql://username:password@localhost:5432/ecommerce_db

# PostgreSQL Docker Container Configuration
POSTGRES_USER=your-username-db
POSTGRES_PASSWORD=replace-with-your-password
POSTGRES_DB=your-database-name

# ============================================
# Mobile Client Configuration (Expo)
# ============================================
# For Docker Compose: Allow requests from Expo Go app (LAN or Android Emulator)
# In development: Set to * to allow all origins
# In production: Set to specific IP of your mobile device or Expo Go
CLIENT_ORIGIN=*