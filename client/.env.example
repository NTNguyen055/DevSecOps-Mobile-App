# ============================================
# Expo Mobile Client Configuration
# ============================================
# API endpoint for the backend server
# Choose the appropriate one based on your setup:

# Android Emulator (default)
# Maps to host machine's localhost
EXPO_PUBLIC_API_URL=http://10.0.2.2:4001

# Physical Device via Expo Go
# Replace xxx with your machine's LAN IP address
# EXPO_PUBLIC_API_URL=http://192.168.1.xxx:4001

# Production / Remote Server
# EXPO_PUBLIC_API_URL=https://api.example.com:4001

# Local Development (if backend runs locally on same network)
# EXPO_PUBLIC_API_URL=http://localhost:4001
